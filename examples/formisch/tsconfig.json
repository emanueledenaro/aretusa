{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@formisch/react": ["./node_modules/@formisch/react"],
      "valibot": ["./node_modules/valibot"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client", "@testing-library/jest-dom"]
  },
  "include": ["./*.ts", "./*.tsx", "../../packages/ui/src/formisch.tsx"]
}
