{
  "name": "aretusa-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/docs/vite.config.ts",
    "build": "npm run registry:build && vite build --config apps/docs/vite.config.ts",
    "registry:build": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run registry:build && vitest run && node --test tests/cli.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "quality:check": "node scripts/check-quality-coverage.mjs",
    "quality:release": "node scripts/check-quality-coverage.mjs --release"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@formisch/react": "^1.1.0",
    "@tanstack/react-form": "^1.33.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.0"
  }
}
